# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///./lorawan.db
DATABASE_ECHO=False

# Encryption Configuration
AES_KEY=your-32-character-aes-key-here!  # Debe ser 32 caracteres

# Gateway Configuration
GATEWAY_TIMEOUT=30
MAX_RETRIES=3
GATEWAY_HEARTBEAT_INTERVAL=60

# Map Configuration
MAP_CENTER_LAT=0.0
MAP_CENTER_LON=0.0
MAP_ZOOM=10

# Message Configuration
MAX_MESSAGE_LENGTH=255
MESSAGE_TTL=3600  # segundos

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_CREDENTIALS=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/server.log
